{
    "about_us_title": "በስተሰብስብ",
    "about_us_header": "Mero የድምጽ ተጫዋች",
    "about_us_intro": "Mero የድምጽ ተጫዋች እንኳን ደህና መጡ! ይህ መተግበሪያ በSleman Dayoub ተሰርቷል ለሁሉም ተጠቃሚዎች ቀላልና ደስታማ የሙዚቃ ተሞክሮ ለማቅረብ።",
    "about_us_mission_title": "እኛ አላማ",
    "about_us_mission": "እኛ የምንደርሰው ለሁሉም ፎርማቶች የሚደግፍ የኦፍላይን ድምጽ ተጫዋች ማቅረብ, እና ዝርዝር ቅንብሮችን እና ተስማሚ ተጠቃሚ ልምድ ማስረጃ ነው።",
    "about_us_features_title": "አስፈላጊ ባህሪያት",
    "about_us_features_point1": "- የአካባቢ የድምጽ ፋይሎችን በሁሉም ፎርማቶች መጫወት።",
    "about_us_features_point2": "- የተለዋዋጭ ቅርጸ ተንቀሳቃሽ: ቀለሞችንና ጀርባዎችን መቀየር።",
    "about_us_features_point3": "- የድምጽ ኢከውላይዘርና የአፈፃፀም ፍጥነት መቆጣጠር።",
    "about_us_features_point4": "- አልበሞች፣ አካዳሚዮችና ዝርዝር ዝናብ (Playlists) ድጋፍ።",
    "about_us_features_point5": "- ቀጥታ ከመተግበሪያው ሪንግተዎን ማቅረብና መቀየር።",
    "about_us_features_point6": "- የድምጽ ፋይሎችን ከሌሎች መተግበሪያዎች ጋር መካፈል።",
    "about_us_contact_title": "አግኙን",
    "about_us_contact": "እባክዎን መሰረታዊ ቻናሎቻችንን ይከታተሉ ወይም በኢሜይል ያግኙን፦",
    "contact_youtube": "የእኛ ዩቱብ ቻናል",
    "contact_linkedin": "የእኛ ሊንክዲን መለያ",
    "contact_telegram": "የእኛ ቴሌግራም መለያ",
    "youtube_url": "www.youtube.com/@SLEMANDayoub-s1t",
    "linkedin_url": "www.linkedin.com/in/sleman-dayoub-6b95a6284",
    "telegram_url": "t.me/sleman_dayoub",
    "privacy_policy_title": "የግል መረጃ ፖሊሲ",
    "privacy_policy_header": "ስለ Mero የድምጽ ተጫዋች የግል መረጃ ፖሊሲ",
    "privacy_policy_intro": "በ Mero የድምጽ ተጫዋች መተግበሪያ ውስጥ የእርስዎን ግል መረጃ መጠበቅና ደህንነት ማረጋገጥ እንደምንቻል እናቀርባለን። ይህ የግል መተግበሪያ በSleman Dayoub ይዞ ነው።",
    "section1_title": "1. የምንሰብስበው መረጃ",
    "section1_point1": "- መተግበሪያው ማንኛውንም ግል መረጃ ከሶስተኛ ወገኖች ጋር አያካፍልም።",
    "section1_point2": "- የድምጽ ፋይሎች፣ ዝርዝሮችና ሪንግቶኖች በእርስዎ መሣሪያ አጠቃላይ ማከማቻ ላይ ብቻ ይቀመጣሉ።",
    "section2_title": "2. የአካባቢ መረጃ አጠቃቀም",
    "section2_point1": "- በአካባቢ የተቀመጠ መረጃ የመተግበሪያ ተጠቃሚ ልምድን ለማሻሻል ብቻ ይጠቀማል።",
    "section2_point2": "- ይህ መረጃ ከተማሪ በአለም አቀፍ መረብ ላይ አይላክም።",
    "section3_title": "3. ፈቃዶች",
    "section3_point1": "- መተግበሪያው በሚጫወቱበት ላይ ብቻ በአካባቢ የድምጽ ፋይሎች መዳረሻ ፈቃድ ይጠይቃል።",
    "section3_point2": "- ሌላ ማንኛውንም መረጃ ሳይገኙ በግል ፈቃድዎ ተጠቃሚ እየሆነ ይወሰዳል።",
    "section4_title": "4. የመረጃ ደህንነት",
    "section4_point1": "- ሁሉም መረጃዎች በመሣሪያዎ ላይ ይቀመጣሉ ስለዚህ የማንሰራሰር ምክንያት እንዳይኖር ይከለክላል።",
    "section4_point2": "- ለግል መረጃዎ ጥሩ የደህንነት ቃል እርግዝና እንዲኖረዎት እናመነዋለን።",
    "section5_title": "5. የተጠቃሚ መብቶች",
    "section5_point1": "- ተጠቃሚዎች የአካባቢ መረጃዎቻቸውን በማንኛውንም ጊዜ ማጥፋት ወይም ማሻሻል ይችላሉ።",
    "section5_point2": "- ተጠቃሚዎች ከመሣሪያዎቻቸው ማሻሻያ በመካከል የመተግበሪያ ፈቃዶችን ማስወገጃ ይችላሉ።",
    "section6_title": "6. አግኙን",
    "section6_point1": "ስለዚህ የግል መረጃ ፖሊሲ ማንኛውም ጥያቄ ካለዎት እባክዎን ያግኙን፦",
    "section7_title": "7. የግል መረጃ ፖሊሲ አዘምነቶች",
    "section7_point1": "- ይህ ፖሊሲ ከጊዜ ወደ ጊዜ ለማዘመን እና ለአዲስ ሕጎች ማስረጃ እንዲሆን ተለዋዋጭ ሊሆን ይችላል።",
    "section7_point2": "- ተጠቃሚዎች ስለ ውድቀት ለሚከተሉት ለተለዋዋጭ ማሻሻያዎች እንዲነግሱ ይታወቃሉ።",
